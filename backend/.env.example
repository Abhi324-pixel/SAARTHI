# =====================================================================================================
# SAARTHI backend settings.  Copy this file to `.env` (same folder) and fill in the values.
# NEVER commit `.env` or paste its contents in chat. Run `python scripts/check_env.py` after editing.
# REQUIRED = needed for the demo.  OPTIONAL = leave as is unless you need it.
# IMPORTANT: write your values right after the "=" and keep comments on their OWN lines (a comment after an
# empty "KEY=" would be read as the value).
# =====================================================================================================

# ---- environment ----------------------------------------------------------------------------------
# dev | prod  (prod hides the demo tools: advance time, simulate struggle, seed history)
SAARTHI_ENV=dev
# REQUIRED: a random string of 32+ characters (signs mock-login tokens and guardian links)
SAARTHI_SECRET=change-me-to-a-long-random-string

# ---- Gemini: all language-model calls ----------------------------------------------------------------
# REQUIRED: from Google AI Studio
GEMINI_API_KEY=
SAARTHI_MODEL=gemini-3.5-flash-lite
# OPTIONAL: comma-separated backup models, for example gemini-2.5-flash
SAARTHI_MODEL_FALLBACKS=gemini-3.1-flash-lite
# gemini | fake   ("fake" = offline test grader with a red banner; NEVER use in the demo)
SAARTHI_LLM_MODE=gemini

# ---- ElevenLabs: voice agent, read-aloud, microphone ---------------------------------------------------
# REQUIRED: the key needs Text to Speech, Speech to Text and Agents permissions
ELEVENLABS_API_KEY=
# REQUIRED: the "SAARTHI Mentor" agent id (see docs/ELEVENLABS_SETUP.md)
ELEVENLABS_AGENT_ID=
# REQUIRED for read-aloud: a voice id from the Voices page
ELEVENLABS_VOICE_ID=
# true ONLY if the agent has Authentication turned OFF
ELEVENLABS_AGENT_PUBLIC=false
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# ---- Database: Supabase Postgres ------------------------------------------------------------------------
# Leave empty to use the local SQLite file (fine for solo testing; data stays on this machine).
# For Supabase: dashboard > Connect > "Session pooler" string, with your password filled in, e.g.
#   postgresql://postgres.<project-ref>:<ENCODED-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# - Use the Session pooler (the direct db.<ref>.supabase.co host is IPv6-only and often fails on Windows).
# - URL-encode special characters in the password:  @ -> %40   : -> %3A   / -> %2F   # -> %23   ? -> %3F
# - "postgresql://" is fine; SAARTHI switches it to the psycopg driver itself.
DATABASE_URL=

# ---- Sign-in: Supabase Auth -----------------------------------------------------------------------------
# mock     = demo login (name + age, no password); nothing else needed
# supabase = real accounts; REQUIRES SUPABASE_URL (the API refuses to start without it)
SAARTHI_AUTH=mock
# REQUIRED when SAARTHI_AUTH=supabase, for example https://<project-ref>.supabase.co
SUPABASE_URL=
# OPTIONAL: leave EMPTY. Only for a project still on the legacy HS256 shared secret.
# (With JWT Signing Keys nothing secret is needed: tokens are checked against {SUPABASE_URL}/auth/v1/.well-known/jwks.json)
SUPABASE_JWT_SECRET=
# The frontend also needs VITE_SUPABASE_URL and VITE_SUPABASE_PUBLISHABLE_KEY in frontend/.env.local (see frontend/.env.example).

# ---- Mock vs real data: flip ONE area at a time (see docs/SWAPPING_MOCK_TO_REAL.md) ----------------------------
# mock | db   (db needs: python scripts/seed.py, and a real database)
SAARTHI_MENTORS=mock
SAARTHI_CONSENT=mock
SAARTHI_COHORT=mock

# ---- E-mail (guardian consent for under-18 learners only) -----------------------------------------------------
# mock = nothing is sent; messages appear in the dev outbox (GET /api/dev/outbox).   smtp = real delivery
SAARTHI_MAIL=mock
# REQUIRED only when SAARTHI_MAIL=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# The address people open in the browser (used to build the link in the guardian e-mail)
PUBLIC_BASE_URL=http://localhost:5173

# ---- Safeguarding lead / admin (real mentors only) ------------------------------------------------------------
# Comma-separated sign-in user ids allowed to review mentor applications (Supabase > Authentication > Users > "User UID").
# Ids only: e-mail addresses are never trusted for admin access. Leave empty to disable the admin pages.
SAARTHI_ADMINS=

# ---- Web -------------------------------------------------------------------------------------------------
# Add your deployed frontend URL here if you host it
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Vakh (practical challenges and reviewed projects) -----------------------------------------------------------
# OPTIONAL. Leave empty and every Vakh feature stays off. Nothing about Vakh is assumed.
# The real address of your Vakh site, https only, for example https://<your-vakh-host>
VAKH_BASE_URL=
# A long random string you also give to Vakh. SAARTHI accepts a review only if it carries a valid
#   X-Vakh-Signature: sha256=<HMAC-SHA256 of the raw request body, using this secret>
VAKH_WEBHOOK_SECRET=
# Set to false to switch every Vakh endpoint off, whatever the other settings are
VAKH_ENABLED=true

# ---- Tavily web search (real learning resources per concept) -------------------------------------------------
# OPTIONAL. Leave empty and the Learn page simply shows no web resources. Never commit a real key.
TAVILY_API_KEY=
